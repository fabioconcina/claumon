{
  "name": "claumon",
  "displayName": "claumon: Claude Code Usage & Limits",
  "description": "See where your Claude Code limits are headed before you hit them: live usage and a forecast in the status bar, plus the claumon dashboard in a panel. Requires the free claumon app.",
  "version": "0.4.3",
  "publisher": "fabioconcina",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabioconcina/claumon.git"
  },
  "homepage": "https://claumon.fabioconcina.com",
  "bugs": {
    "url": "https://github.com/fabioconcina/claumon/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "claude-code",
    "anthropic",
    "usage",
    "usage limit",
    "rate limit",
    "forecast",
    "tokens",
    "cost",
    "monitor",
    "dashboard"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "claumon makes network requests to the configured host and embeds it in a webview, so it stays disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "claumon.openDashboard",
        "title": "claumon: Open Dashboard"
      },
      {
        "command": "claumon.reconnect",
        "title": "claumon: Reconnect"
      }
    ],
    "configuration": {
      "title": "claumon",
      "properties": {
        "claumon.host": {
          "type": "string",
          "default": "127.0.0.1",
          "scope": "machine",
          "description": "Hostname where the claumon server is running. Machine-scoped: cannot be set per-workspace, so an untrusted repo cannot redirect the extension to another host."
        },
        "claumon.port": {
          "type": "number",
          "default": 3131,
          "scope": "machine",
          "description": "Port where the claumon server is listening. Machine-scoped: cannot be set per-workspace."
        },
        "claumon.statusBar.metric": {
          "type": "string",
          "enum": [
            "session",
            "weekly"
          ],
          "default": "session",
          "description": "Which usage metric to show in the status bar item."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "vscode:prepublish": "npm run compile",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.85.0",
    "typescript": "7.0.2"
  }
}
